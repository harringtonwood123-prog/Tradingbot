# Copy to .env and fill in:   cp .env.example .env
# .env is ignored by git. Never share it or paste it into chat.

# Alpaca API keys (from your Alpaca dashboard; paper-account keys work for market data)
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# The SEC requires automated tools to identify themselves with a name and email.
SEC_USER_AGENT="Your Name your.email@example.com"
